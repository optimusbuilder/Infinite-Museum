# Gemini (recommended) — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

# Optional: force provider when both keys are set (gemini | openai)
# LLM_PROVIDER=gemini

# Optional: override model
# GEMINI_MODEL=gemini-2.5-flash

# OpenAI (alternative)
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini
